<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Discount_Limit</fullName>
    <active>true</active>
    <errorConditionFormula>Discount__c &gt; 0.70</errorConditionFormula>
    <errorDisplayField>Discount__c</errorDisplayField>
    <errorMessage>Discount percentage cannot exceed 70%.</errorMessage>
</ValidationRule>
