<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Broadcast when a customer submits a case</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <description>Id of the new case</description>
        <fieldName>caseId</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Case number of the new case</description>
        <fieldName>caseNumber</fieldName>
    </lightningMessageFields>
    <masterLabel>CaseCreated</masterLabel>
</LightningMessageChannel>